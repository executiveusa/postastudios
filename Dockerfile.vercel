FROM dunglas/frankenphp:1-php8.4-bookworm AS base

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions \
        pdo_pgsql \
        pgsql \
        gd \
        zip \
        bcmath \
        exif \
        pcntl \
        intl \
        sockets \
        redis

WORKDIR /app

FROM base AS build

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY --from=node:22-bookworm-slim /usr/local/ /usr/local/

COPY composer.json composer.lock package.json package-lock.json ./

RUN composer install \
        --no-dev \
        --no-interaction \
        --no-progress \
        --no-scripts \
        --prefer-dist \
    && npm ci --no-audit --no-fund

COPY . .

RUN mkdir -p \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache

ENV APP_KEY=base64:c3R1Yi13YXlmaW5kZXItYnVpbGQta2V5LW9ubHktbm90LXJ1bnRpbWU= \
    APP_ENV=production \
    APP_DEBUG=false \
    APP_URL=http://localhost \
    CACHE_STORE=array \
    SESSION_DRIVER=array \
    QUEUE_CONNECTION=sync \
    BROADCAST_CONNECTION=log \
    VITE_APP_NAME="Posta Studio"

RUN composer dump-autoload --no-dev --classmap-authoritative \
    && php artisan wayfinder:generate --with-form \
    && npm run build

FROM base AS runtime

COPY --from=build --chown=www-data:www-data /app /app
COPY --chown=www-data:www-data Caddyfile.vercel /etc/frankenphp/Caddyfile

RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy /app/storage /app/bootstrap/cache

ENV PORT=80 \
    APP_NAME="Posta Studio" \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    CACHE_STORE=array \
    SESSION_DRIVER=array \
    QUEUE_CONNECTION=sync \
    BROADCAST_CONNECTION=log

USER www-data

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
